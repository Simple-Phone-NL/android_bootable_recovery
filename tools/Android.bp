package {
    default_applicable_licenses: ["bootable_recovery_license"],
}

// Recovery command server library (used by recovery binary)
cc_library_static {
    name: "librecovery_command_server",

    srcs: [
        "recovery_command_server.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    header_libs: [
        "libbase_headers",
    ],

    shared_libs: [
        "libbase",
        "libbootloader_message",
        "liblog",
    ],

    export_include_dirs: [
        ".",
    ],
}

// recoveryctl command line tool
cc_binary {
    name: "recoveryctl",

    srcs: [
        "recoveryctl.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    shared_libs: [
        "libbase",
        "liblog",
    ],
}
